---
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

const { locale } = Astro.props;
const t = useTranslations(locale);

const allPosts = await getCollection('posts');
const posts = allPosts
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

function getPostUrl(post) {
  return `/blog/${post.id}`;
}
---

<div class="feed-home">
  <section class="feed" aria-label="最新文章">
    <div class="section-heading">
      <h2>最新文章</h2>
      <a href="/archive">{t('viewAll')}</a>
    </div>

    <ol class="feed-list">
      {posts.map(post => (
        <li class="feed-item">
          <a href={getPostUrl(post)} class="feed-link">
            <h3 class="feed-title">{post.data.title}</h3>
            <time class="feed-time" datetime={post.data.date}>{post.data.date}</time>
            <p class="feed-excerpt">{post.data.excerpt}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>
</div>

<style>
  :global(main) {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-top: var(--space-lg);
  }

  .feed-home {
    display: grid;
    gap: var(--space-xl);
  }

  h2,
  h3 {
    color: var(--color-text);
    letter-spacing: 0;
    text-wrap: balance;
  }

  .feed {
    display: grid;
    gap: var(--space-md);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .section-heading a {
    color: var(--color-text-muted);
    font-size: 0.86rem;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.18em;
  }

  .section-heading a:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .feed-list {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .feed-item + .feed-item {
    border-top: 1px solid var(--color-border);
  }

  .feed-link {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 0;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .feed-link:hover {
    background-color: var(--color-surface);
  }

  .feed-title {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-text);
  }

  .feed-link:hover .feed-title {
    color: var(--color-accent);
  }

  .feed-time {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .feed-excerpt {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  @media (max-width: 640px) {
    :global(main) {
      padding-top: var(--space-md);
    }

    .feed-home {
      gap: var(--space-lg);
    }

    .feed-link {
      padding: 0.85rem 0;
    }
  }
</style>
