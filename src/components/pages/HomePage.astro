---
import { getCollection } from 'astro:content';
import {
  categoryLabels,
  getCategories,
  getTopicPath,
  topics,
} from '../../lib/categories.js';
import { useTranslations } from '../../i18n/utils';

const { locale } = Astro.props;
const t = useTranslations(locale);

const allPosts = await getCollection('posts');
const posts = allPosts
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const categorySections = topics
  .map(topic => {
    const categoryPosts = posts.filter(post =>
      getCategories(post.data.tags || [], post.data.category).includes(topic.key)
    );

    return {
      topic,
      label: categoryLabels[topic.key] || topic.label,
      count: categoryPosts.length,
      posts: categoryPosts.slice(0, 8),
    };
  })
  .filter(section => section.posts.length > 0);

function getPostSlug(post) {
  return post.id;
}

function getPostUrl(post) {
  return `/blog/${getPostSlug(post)}`;
}
---

<div class="minimal-home">
  <section class="category-index" aria-label="分类文章">
    <div class="section-heading">
      <h2>文章分类</h2>
      <a href="/archive">{t('viewAll')}</a>
    </div>

    <div class="category-list">
      {categorySections.map(section => (
        <section class="category-section">
          <header class="category-header">
            <h3>
              <a href={getTopicPath(section.topic)}>{section.label}</a>
            </h3>
          </header>

          <ol class="post-list">
            {section.posts.map(post => (
              <li>
                <time datetime={post.data.date}>{post.data.date}</time>
                <a href={getPostUrl(post)}>{post.data.title}</a>
              </li>
            ))}
          </ol>

          {section.count > section.posts.length && (
            <a class="topic-more" href={getTopicPath(section.topic)}>
              查看更多
            </a>
          )}
        </section>
      ))}
    </div>
  </section>
</div>

<style>
  :global(main) {
    max-width: var(--wide-width);
    padding-top: var(--space-lg);
  }

  .minimal-home {
    display: grid;
    gap: var(--space-xl);
  }

  h1,
  h2,
  h3 {
    color: var(--color-text);
    letter-spacing: 0;
    text-wrap: balance;
  }

  .category-index {
    display: grid;
    gap: var(--space-md);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .section-heading a,
  .topic-more {
    color: var(--color-text-muted);
    font-size: 0.86rem;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.18em;
  }

  .section-heading a:hover,
  .topic-more:hover,
  .category-header a:hover,
  .post-list a:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .category-list {
    display: grid;
    gap: var(--space-xl) 2.25rem;
  }

  .category-section {
    padding-bottom: var(--space-lg);
  }

  .category-header {
    margin-bottom: 0.9rem;
  }

  .category-header h3 {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 700;
  }

  .post-list {
    display: grid;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    display: grid;
    grid-template-columns: 5.6rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
    line-height: 1.55;
  }

  .post-list time {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .post-list a {
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .topic-more {
    display: inline-block;
    margin-top: 0.9rem;
  }

  @media (max-width: 640px) {
    :global(main) {
      padding-top: var(--space-md);
    }

    .minimal-home {
      gap: var(--space-lg);
    }

    .section-heading {
      align-items: flex-start;
    }

    .post-list li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }

  @media (min-width: 760px) {
    .category-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .post-list li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
