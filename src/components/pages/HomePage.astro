---
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

const { locale } = Astro.props;
const t = useTranslations(locale);

const PAGE_SIZE = 30;

const allPosts = await getCollection('posts');
const posts = allPosts
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const initialPosts = posts.slice(0, PAGE_SIZE);
---

<div class="feed-home">
  <section class="feed" aria-label={t('home.latest')}>
    <ol class="feed-list" id="feed-list">
      {initialPosts.map(post => (
        <li class="feed-item">
          <a href={`/blog/${post.id}`} class="feed-link">
            <h3 class="feed-title">{post.data.title}</h3>
            <time class="feed-time" datetime={post.data.date}>{post.data.date}</time>
            <p class="feed-excerpt">{post.data.excerpt}</p>
          </a>
        </li>
      ))}
    </ol>

    <template id="feed-item-template">
      <li class="feed-item">
        <a class="feed-link">
          <h3 class="feed-title"></h3>
          <time class="feed-time"></time>
          <p class="feed-excerpt"></p>
        </a>
      </li>
    </template>

    <div class="feed-more">
      <button
        type="button"
        id="feed-more-btn"
        class="feed-more-btn"
        data-page-size={PAGE_SIZE}
        data-total={posts.length}
        data-endpoint="/posts.json"
        data-label-more={t('home.loadMore')}
        data-label-loading={t('home.loading')}
        data-label-error={t('home.loadError')}
        data-progress-template={t('postCount', { shown: '__SHOWN__', total: posts.length })}
      >{t('home.loadMore')}</button>
      <p class="feed-progress" id="feed-progress" aria-live="polite">
        {t('postCount', { shown: initialPosts.length, total: posts.length })}
      </p>
    </div>
  </section>
</div>

<script>
  const list = document.getElementById('feed-list');
  const button = document.getElementById('feed-more-btn');
  const progress = document.getElementById('feed-progress');
  const template = document.getElementById('feed-item-template');

  if (list && button && progress && template) {
    const pageSize = Number(button.dataset.pageSize);
    const total = Number(button.dataset.total);
    const labels = {
      more: button.dataset.labelMore,
      loading: button.dataset.labelLoading,
      error: button.dataset.labelError,
    };

    let allPosts = null;
    let shown = list.children.length;

    function createItem(post) {
      const item = template.content.firstElementChild.cloneNode(true);
      item.querySelector('.feed-link').href = `/blog/${post.id}`;
      item.querySelector('.feed-title').textContent = post.title;

      const time = item.querySelector('.feed-time');
      time.dateTime = post.date;
      time.textContent = post.date;

      item.querySelector('.feed-excerpt').textContent = post.excerpt;
      return item;
    }

    function formatProgress() {
      return button.dataset.progressTemplate.replace('__SHOWN__', String(shown));
    }

    async function fetchPosts() {
      if (!allPosts) {
        const response = await fetch(button.dataset.endpoint);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        allPosts = await response.json();
      }
      return allPosts;
    }

    button.addEventListener('click', async () => {
      button.disabled = true;
      button.textContent = labels.loading;

      try {
        const posts = await fetchPosts();
        const next = posts.slice(shown, shown + pageSize);
        const fragment = document.createDocumentFragment();
        next.forEach(post => fragment.append(createItem(post)));
        list.append(fragment);

        shown += next.length;
        progress.textContent = formatProgress();

        // The button is the only way to reach the rest of the feed, so hide it
        // once every post is on the page rather than leaving a dead control.
        if (shown >= total) {
          button.hidden = true;
        } else {
          button.disabled = false;
          button.textContent = labels.more;
        }
      } catch (error) {
        console.error('Failed to load more posts', error);
        button.textContent = labels.error;
        button.disabled = false;
      }
    });
  }
</script>

<style>
  :global(main) {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-top: var(--space-lg);
  }

  .feed-home {
    display: grid;
    gap: var(--space-xl);
  }

  h3 {
    color: var(--color-text);
    letter-spacing: 0;
    text-wrap: balance;
  }

  .feed {
    display: grid;
    gap: var(--space-md);
  }

  .feed-list {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .feed-item + .feed-item {
    border-top: 1px solid var(--color-border);
  }

  .feed-link {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 0;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .feed-link:hover {
    background-color: var(--color-surface);
  }

  .feed-title {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-text);
  }

  .feed-link:hover .feed-title {
    color: var(--color-accent);
  }

  .feed-time {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .feed-excerpt {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .feed-more {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    padding-top: 0.5rem;
  }

  .feed-more-btn {
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.55rem 1.7rem;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }

  .feed-more-btn:hover:not(:disabled) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .feed-more-btn:disabled {
    cursor: default;
    opacity: 0.6;
  }

  .feed-progress {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  @media (max-width: 640px) {
    :global(main) {
      padding-top: var(--space-md);
    }

    .feed-home {
      gap: var(--space-lg);
    }

    .feed-link {
      padding: 0.85rem 0;
    }
  }
</style>
