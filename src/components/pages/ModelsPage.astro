---
import { labOrder, modelReleases, type ModelRelease } from '../../data/model-releases';

const START_YEAR = 2024;
const START_MONTH = 1;
const END_YEAR = 2026;
const END_MONTH = 11;

const AXIS_W = 72;
const COL_W = 138;
const PAD_R = 16;
const TRACK_TOP = 8;
const TODAY_Y = 26;
const MONTHS_TOP = 42;
const DOT_R = 5.5;
// Centre-to-centre distance between two release rows inside a month.
const ROW_PITCH = 14;
// Vertical breathing room at the top and bottom of each month band.
const BAND_PAD = 6;

const MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function yearMonth(date: string) {
  return date.slice(0, 7);
}

// Row 0 is the latest month (top); row increases going backward in time.
function rowForMonth(ym: string) {
  const [year, month] = ym.split('-').map(Number);
  return (END_YEAR - year) * 12 + (END_MONTH - month);
}

const monthCount = rowForMonth(`${START_YEAR}-${String(START_MONTH).padStart(2, '0')}`) + 1;
const plotW = labOrder.length * COL_W;
const width = AXIS_W + plotW + PAD_R;

function colCenterX(col: number) {
  return AXIS_W + col * COL_W + COL_W / 2;
}

// Group by lab and month, and collect each month's distinct release dates.
const releasesByLab = new Map<string, Map<string, ModelRelease[]>>(
  labOrder.map((lab) => [lab, new Map()]),
);
const datesByMonth = new Map<string, string[]>();
const seenLabDates = new Set<string>();

for (const release of modelReleases) {
  const byMonth = releasesByLab.get(release.lab);
  if (!byMonth) throw new Error(`Unknown lab: ${release.lab}`);

  const month = yearMonth(release.date);
  const row = rowForMonth(month);
  if (row < 0 || row >= monthCount) {
    throw new Error(`Month out of range: ${release.lab} ${release.date}`);
  }

  // Two releases on one date would land on the same dot; fold them into one entry.
  const key = `${release.lab}|${release.date}`;
  if (seenLabDates.has(key)) {
    throw new Error(`Two ${release.lab} releases share ${release.date}; merge them into one entry`);
  }
  seenLabDates.add(key);

  const bucket = byMonth.get(month);
  if (bucket) bucket.push(release);
  else byMonth.set(month, [release]);

  const dates = datesByMonth.get(month);
  if (!dates) datesByMonth.set(month, [release.date]);
  else if (!dates.includes(release.date)) dates.push(release.date);
}

/**
 * Every month gets exactly the same height, so the vertical scale can't skew:
 * one month is always the same amount of space, whatever shipped in it.
 *
 * Inside a band, each distinct release date gets its own row, newest at the
 * top, laid out at a constant pitch and centred vertically. Order is the part
 * that has to be exact — up is always later, so a lab's release can never look
 * like it came before another lab's when it actually came after — while the
 * rows are evenly spaced rather than proportional to the days between them,
 * because two days apart would be a few pixels at this scale.
 *
 * Band height therefore follows the busiest month, which needs the most rows.
 */
const maxRows = Math.max(1, ...[...datesByMonth.values()].map((dates) => dates.length));
const MONTH_H = maxRows * ROW_PITCH + BAND_PAD * 2;

const months = Array.from({ length: monthCount }, (_, row) => {
  const totalMonths = END_YEAR * 12 + (END_MONTH - 1) - row;
  const year = Math.floor(totalMonths / 12);
  const monthNumber = (totalMonths % 12) + 1;
  const key = `${year}-${String(monthNumber).padStart(2, '0')}`;
  const dates = [...(datesByMonth.get(key) ?? [])].sort().reverse();
  const top = MONTHS_TOP + row * MONTH_H;

  return {
    row,
    year,
    monthNumber,
    key,
    name: MONTH_NAMES[monthNumber - 1],
    top,
    height: MONTH_H,
    bottom: top + MONTH_H,
    center: top + MONTH_H / 2,
    dates,
    // Sparse months centre their few rows instead of stacking them at the top.
    inset: (MONTH_H - dates.length * ROW_PITCH) / 2,
    isJan: monthNumber === 1,
    // Horizontal divider below Jan separates this year from the previous year below it.
    hasYearDivider: monthNumber === 1 && year > START_YEAR,
  };
});

const trackBottom = MONTHS_TOP + monthCount * MONTH_H + 12;
const plotH = monthCount * MONTH_H;
const height = trackBottom + 16;

let firstDot = true;

const columns = labOrder.map((lab, col) => {
  const cx = colCenterX(col);
  const rawDots: Array<{
    date: string;
    models: string;
    col: number;
    row: number;
    cx: number;
    cy: number;
    limited: boolean;
    label: string;
  }> = [];

  for (const [month, bucket] of releasesByLab.get(lab)!.entries()) {
    const band = months[rowForMonth(month)];
    const [year, monthNumber] = month.split('-').map(Number);

    for (const release of bucket) {
      const day = Number(release.date.slice(8, 10));
      const slot = band.dates.indexOf(release.date);
      rawDots.push({
        date: release.date,
        models: release.models,
        col,
        row: band.row,
        cx,
        cy: Number((band.top + band.inset + (slot + 0.5) * ROW_PITCH).toFixed(2)),
        limited: release.limited === true,
        label: `${lab}，${year}年${monthNumber}月${day}日，${release.models}`,
      });
    }
  }

  // Sort top-to-bottom (newest to oldest) so hit boxes partition cleanly without overlap.
  rawDots.sort((a, b) => a.cy - b.cy);

  const dots = rawDots.map((dot, index) => {
    const prev = rawDots[index - 1];
    const next = rawDots[index + 1];
    const hitTop = prev
      ? Math.max(dot.cy - 24, (prev.cy + dot.cy) / 2)
      : Math.max(MONTHS_TOP, dot.cy - 24);
    const hitBottom = next
      ? Math.min(dot.cy + 24, (dot.cy + next.cy) / 2)
      : Math.min(trackBottom, dot.cy + 24);
    const tabIndex = firstDot ? 0 : -1;
    firstDot = false;
    return {
      ...dot,
      hitX: cx - COL_W / 2,
      hitY: Number(hitTop.toFixed(2)),
      hitH: Number(Math.max(10, hitBottom - hitTop).toFixed(2)),
      tabIndex,
    };
  });

  // Build a vertical track path that pauses cleanly around dotted (limited) rings
  // so the track never touches the dots and no opaque halo shows over the hover band.
  const limitedGaps = dots
    .filter((dot) => dot.limited)
    .map((dot) => [dot.cy - (DOT_R + 2), dot.cy + (DOT_R + 2)] as const);

  const trackSegments: string[] = [];
  let cursor = TRACK_TOP;
  for (const [gapStart, gapEnd] of limitedGaps) {
    if (gapStart > cursor) {
      trackSegments.push(`M ${cx} ${cursor.toFixed(2)} V ${gapStart.toFixed(2)}`);
    }
    cursor = Math.max(cursor, gapEnd);
  }
  if (trackBottom > cursor) {
    trackSegments.push(`M ${cx} ${cursor.toFixed(2)} V ${trackBottom.toFixed(2)}`);
  }
  const trackPath = trackSegments.join(' ');

  return { lab, col, cx, trackPath, dots };
});

// Hairline ink for each lab. OpenAI and xAI publish black-and-white marks, so they follow the text color.
const brandInk: Record<string, string> = {
  OpenAI: 'var(--color-text)',
  Anthropic: 'oklch(0.672 0.131 38.8)',
  Google: 'oklch(0.63 0.18 260)',
  xAI: 'var(--color-text)',
  Meta: 'oklch(0.616 0.204 255.1)',
  GLM: 'oklch(0.552 0.247 267.9)',
  Kimi: 'oklch(0.607 0.215 257)',
  DeepSeek: 'oklch(0.592 0.22 269.6)',
};

const headerCols = `${AXIS_W}fr repeat(${labOrder.length}, ${COL_W}fr) ${PAD_R}fr`;
---

<section class="models-page">
  <header class="models-head">
    <h2 id="models-heading">模型发布时间线</h2>
    <div class="legend" aria-label="图例">
      <span class="legend-item">
        <svg class="legend-dot" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <circle class="legend-circle legend-circle--ga" cx="8" cy="8" r="5" />
        </svg>
        <span>公开发布</span>
      </span>
      <span class="legend-item">
        <svg class="legend-dot" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <circle class="legend-circle legend-circle--limited" cx="8" cy="8" r="5" />
        </svg>
        <span>有限访问</span>
      </span>
    </div>
  </header>

  <div class="chart" data-models-chart>
    <div class="chart-scroll">
      <div class="chart-inner" style={`--chart-w:${width}px`}>
        <div
          class="lab-header"
          aria-hidden="true"
          style={`grid-template-columns:${headerCols}`}
        >
          <div class="lab-axis-spacer"></div>
          {columns.map((column) => (
            <div class="lab-name">{column.lab}</div>
          ))}
          <div class="lab-pad-spacer"></div>
        </div>

        <svg
          class="plot"
          viewBox={`0 0 ${width} ${height}`}
          width={width}
          height={height}
          role="group"
          aria-labelledby="models-heading"
          data-axis-w={AXIS_W}
          data-pad-r={PAD_R}
          data-track-top={TRACK_TOP}
        >
          <rect
            class="plot-hit"
            x={AXIS_W}
            y={MONTHS_TOP}
            width={plotW}
            height={plotH}
            fill="transparent"
          />

          <g class="month-mark" data-month-mark aria-hidden="true">
            <rect class="month-bar" data-month-bar />
          </g>

          {months.map((m) => m.hasYearDivider && (
            <line
              class="guide"
              x1={AXIS_W}
              x2={width - PAD_R}
              y1={m.bottom}
              y2={m.bottom}
            />
          ))}

          <g class="today-mark" aria-hidden="true">
            <text class="today-label" x={AXIS_W - 14} y={TODAY_Y}>Today</text>
            <line
              class="today-line"
              x1={AXIS_W}
              x2={width - PAD_R}
              y1={TODAY_Y}
              y2={TODAY_Y}
            />
          </g>

          <g class="time-axis" aria-hidden="true">
            {months.map((m) => (
              <>
                <text
                  class="month-axis-label"
                  data-month-row={m.row}
                  data-top={m.top}
                  data-height={m.height}
                  x={AXIS_W - 14}
                  y={m.isJan ? m.top + 20 : m.center}
                >
                  {m.name}
                </text>
                {m.isJan && (
                  <text class="year-label" x={AXIS_W - 14} y={m.top + 39}>
                    {m.year}
                  </text>
                )}
              </>
            ))}
          </g>

          {columns.map((column) => (
            <g class="lab-col" style={`--ink:${brandInk[column.lab]}`}>
              <path class="rule" d={column.trackPath} />
              {column.dots.map((dot) => (
                <g
                  class:list={['release', { 'is-limited': dot.limited }]}
                  tabindex={dot.tabIndex}
                  role="button"
                  aria-label={dot.label}
                  data-models={dot.models}
                  data-date={dot.date}
                  data-cx={dot.cx}
                  data-cy={dot.cy}
                  data-col={dot.col}
                  data-row={dot.row}
                >
                  <rect
                    class="hit"
                    x={dot.hitX}
                    y={dot.hitY}
                    width={COL_W}
                    height={dot.hitH}
                    fill="transparent"
                  />
                  <circle class="ring" cx={dot.cx} cy={dot.cy} r={DOT_R + 4.5} />
                  <circle class="mark" cx={dot.cx} cy={dot.cy} r={DOT_R} />
                </g>
              ))}
            </g>
          ))}

          <g class="callout" data-callout aria-hidden="true">
            <path class="callout-line" data-callout-line />
            <rect class="callout-bg" data-callout-bg rx="3" ry="3" />
            <text class="callout-text" data-callout-text></text>
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  :global(html:has(.models-page) .header-inner),
  :global(html:has(.models-page) main),
  :global(html:has(.models-page) .site-footer) {
    max-width: var(--wide-width);
  }

  .models-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .models-head h2 {
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
    margin-bottom: 0;
  }

  .legend {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }

  .legend-dot {
    display: block;
    flex: none;
  }

  .legend-circle {
    fill: var(--color-bg);
    stroke: var(--color-text);
  }

  .legend-circle--ga {
    stroke-width: 1.75;
  }

  .legend-circle--limited {
    stroke-width: 1.8;
    stroke-dasharray: 0.01 3.14;
    stroke-linecap: round;
  }

  .chart {
    width: 100%;
  }

  .chart-scroll {
    width: 100%;
  }

  .chart-inner {
    width: 100%;
    max-width: var(--chart-w);
  }

  .lab-header {
    position: sticky;
    top: 0;
    z-index: 2;
    display: grid;
    align-items: end;
    padding: 0.65rem 0 0.55rem;
    background: var(--color-bg);
    transition: background-color 0.4s ease;
  }

  .lab-name {
    text-align: center;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--color-text);
  }

  .plot {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
    overflow: visible;
  }

  .today-label {
    fill: var(--color-text);
    font-size: 13px;
    font-weight: 500;
    text-anchor: end;
    dominant-baseline: central;
  }

  .today-line {
    stroke: var(--color-rule);
    stroke-width: 1;
  }

  .guide {
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .month-axis-label {
    fill: var(--color-text-muted);
    font-size: 12px;
    font-weight: 400;
    text-anchor: end;
    dominant-baseline: central;
    transition: fill 100ms ease;
  }

  .month-axis-label.is-active {
    fill: var(--color-text);
    font-weight: 600;
  }

  .year-label {
    fill: var(--color-text);
    font-size: 13px;
    font-weight: 600;
    text-anchor: end;
    dominant-baseline: central;
    font-variant-numeric: tabular-nums;
  }

  .month-mark {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .month-mark.is-open {
    opacity: 1;
    visibility: visible;
  }

  .month-bar {
    fill: color-mix(in srgb, var(--color-text) 7%, transparent);
  }

  .rule,
  .mark {
    stroke: var(--ink, var(--color-text));
  }

  .rule {
    fill: none;
    stroke-width: 1.35;
  }

  .mark {
    fill: var(--color-bg);
    stroke-width: 1.75;
  }

  .ring {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 1;
    opacity: 0;
  }

  .release {
    cursor: pointer;
    scroll-margin-top: 72px;
    -webkit-tap-highlight-color: transparent;
  }

  .release:focus {
    outline: none;
  }

  .release:focus-visible .ring {
    opacity: 0.55;
  }

  .release.is-on .mark {
    stroke-width: 2.35;
  }

  /* 10 evenly spaced round dots around a circle of radius 5.5 (circumference 34.558). */
  .release.is-limited .mark {
    fill: transparent;
    stroke-width: 1.9;
    stroke-dasharray: 0.01 3.446;
    stroke-linecap: round;
  }

  .release.is-limited.is-on .mark {
    stroke-width: 2.35;
  }

  .callout {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform-box: view-box;
    transform-origin: 0 0;
    transform: scale(0.97);
  }

  .callout.is-open {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .month-mark {
      transition:
        opacity 100ms cubic-bezier(0.4, 0, 1, 1),
        visibility 0s linear 100ms;
    }

    .month-mark.is-open {
      transition:
        opacity 125ms cubic-bezier(0.32, 0.72, 0, 1),
        visibility 0s linear 0s;
    }

    .callout {
      transition:
        opacity 100ms cubic-bezier(0.4, 0, 1, 1),
        transform 100ms cubic-bezier(0.4, 0, 1, 1),
        visibility 0s linear 100ms;
    }

    .callout.is-open {
      transition:
        opacity 125ms cubic-bezier(0.32, 0.72, 0, 1),
        transform 125ms cubic-bezier(0.32, 0.72, 0, 1),
        visibility 0s linear 0s;
    }
  }

  .chart.is-instant .month-mark,
  .chart.is-instant .month-mark.is-open,
  .chart.is-instant .callout,
  .chart.is-instant .callout.is-open {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .month-mark,
    .month-mark.is-open,
    .month-axis-label,
    .callout,
    .callout.is-open {
      transition: none;
    }
  }

  .callout-line {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .callout-bg {
    fill: var(--color-bg);
  }

  .callout-text {
    fill: var(--color-text);
    font-size: 14px;
    font-weight: 400;
    dominant-baseline: text-before-edge;
  }

  @media (max-width: 819px) {
    .chart-scroll {
      overflow-x: auto;
      overscroll-behavior-x: contain;
    }

    .chart-scroll::-webkit-scrollbar {
      height: 8px;
    }

    .chart-scroll::-webkit-scrollbar-thumb {
      background: rgba(0, 0, 0, 0.2);
      border-radius: 4px;
    }

    :global([data-theme="dark"]) .chart-scroll::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.22);
    }

    .chart-inner {
      min-width: 760px;
    }

    .lab-header {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .models-head h2 {
      font-size: 1.5rem;
    }

    .lab-name {
      font-size: 0.8125rem;
    }
  }
</style>

<script>
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const LINE_LIMIT = 280;

  function estimate(text: string) {
    let width = 0;
    for (const char of text) width += char.charCodeAt(0) > 255 ? 14 : 7.7;
    return width;
  }

  function wrapModels(raw: string) {
    const lines: string[] = [];
    for (const part of raw.split('；').map((item) => item.trim()).filter(Boolean)) {
      if (estimate(part) <= LINE_LIMIT) {
        lines.push(part);
        continue;
      }
      let current = '';
      for (const bit of part.split(' / ')) {
        const next = current ? `${current} / ${bit}` : bit;
        if (current && estimate(next) > LINE_LIMIT) {
          lines.push(current);
          current = bit;
        } else {
          current = next;
        }
      }
      if (current) lines.push(current);
    }
    return lines.length ? lines : [raw];
  }

  function initModelsChart() {
    const root = document.querySelector<HTMLElement>('[data-models-chart]');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const svg = root.querySelector<SVGSVGElement>('svg.plot');
    const callout = root.querySelector<SVGGElement>('[data-callout]');
    const calloutLine = root.querySelector<SVGPathElement>('[data-callout-line]');
    const calloutBg = root.querySelector<SVGRectElement>('[data-callout-bg]');
    const calloutText = root.querySelector<SVGTextElement>('[data-callout-text]');
    const monthMark = root.querySelector<SVGGElement>('[data-month-mark]');
    const monthBar = root.querySelector<SVGRectElement>('[data-month-bar]');
    if (!svg || !callout || !calloutLine || !calloutBg || !calloutText || !monthMark || !monthBar) {
      return;
    }

    const dots = [...svg.querySelectorAll<SVGGElement>('.release')];
    const monthLabels = new Map<number, SVGTextElement>();
    const bands: Array<{ row: number; top: number; height: number }> = [];
    for (const label of svg.querySelectorAll<SVGTextElement>('[data-month-row]')) {
      const row = Number(label.dataset.monthRow);
      monthLabels.set(row, label);
      bands.push({ row, top: Number(label.dataset.top), height: Number(label.dataset.height) });
    }
    bands.sort((a, b) => a.top - b.top);

    const svgWidth = svg.viewBox.baseVal.width;
    const svgHeight = svg.viewBox.baseVal.height;
    const axisW = Number(svg.dataset.axisW);
    const padR = Number(svg.dataset.padR);
    const trackTop = Number(svg.dataset.trackTop);

    let pinned: SVGGElement | null = null;
    let activeMonthRow = -1;

    function rowFromEvent(event: PointerEvent | MouseEvent) {
      const point = svg.createSVGPoint();
      point.x = event.clientX;
      point.y = event.clientY;
      const matrix = svg.getScreenCTM();
      if (!matrix) return -1;
      const local = point.matrixTransform(matrix.inverse());
      if (local.x < axisW || local.x > svgWidth - padR) return -1;
      // Bands have uneven heights, so find the one containing the pointer.
      const band = bands.find((item) => local.y >= item.top && local.y < item.top + item.height);
      return band ? band.row : -1;
    }

    function showMonth(row: number) {
      if (activeMonthRow !== row) {
        if (activeMonthRow >= 0) {
          monthLabels.get(activeMonthRow)?.classList.remove('is-active');
        }
        activeMonthRow = row;
        if (row >= 0) {
          monthLabels.get(row)?.classList.add('is-active');
        }
      }
      const band = row >= 0 ? bands.find((item) => item.row === row) : undefined;
      if (!band) {
        monthMark.classList.remove('is-open');
        return;
      }
      monthBar.setAttribute('x', String(axisW));
      monthBar.setAttribute('y', String(band.top));
      monthBar.setAttribute('width', String(svgWidth - axisW - padR));
      monthBar.setAttribute('height', String(band.height));
      monthMark.classList.add('is-open');
    }

    function clearMark() {
      for (const dot of dots) dot.classList.remove('is-on');
      callout.classList.remove('is-open');
    }

    function show(dot: SVGGElement) {
      for (const item of dots) item.classList.toggle('is-on', item === dot);
      const cx = Number(dot.dataset.cx);
      const cy = Number(dot.dataset.cy);
      const lines = wrapModels(dot.dataset.models || '');

      calloutText.replaceChildren();
      for (const [index, line] of lines.entries()) {
        const tspan = document.createElementNS(SVG_NS, 'tspan');
        tspan.textContent = line;
        tspan.setAttribute('dy', index === 0 ? '0' : '1.35em');
        calloutText.appendChild(tspan);
      }

      const place = (sign: number) => {
        calloutText.setAttribute('text-anchor', sign === 1 ? 'start' : 'end');
        calloutText.setAttribute('x', '0');
        calloutText.setAttribute('y', '0');
        for (const tspan of calloutText.querySelectorAll('tspan')) tspan.setAttribute('x', '0');
        const measured = calloutText.getBBox();
        const textHeight = Math.max(measured.height, 16);

        let top = cy - textHeight / 2 - 12;
        if (top < trackTop + 4) {
          top = Math.min(cy + 10, svgHeight - textHeight - 6);
        } else if (top + textHeight > svgHeight - 6) {
          top = svgHeight - textHeight - 6;
        }

        const run = 18;
        const stub = 10;
        const leaderY = top + Math.min(11, textHeight * 0.5);
        const elbowX = cx + sign * run;
        const stubX = elbowX + sign * stub;
        const dx = elbowX - cx;
        const dy = leaderY - cy;
        const length = Math.hypot(dx, dy) || 1;
        const x0 = cx + (dx / length) * 7.5;
        const y0 = cy + (dy / length) * 7.5;
        calloutLine.setAttribute(
          'd',
          `M ${x0.toFixed(1)} ${y0.toFixed(1)} L ${elbowX.toFixed(1)} ${leaderY.toFixed(1)} L ${stubX.toFixed(1)} ${leaderY.toFixed(1)}`,
        );

        const textX = stubX + sign * 6;
        calloutText.setAttribute('x', String(textX));
        calloutText.setAttribute('y', String(top));
        for (const tspan of calloutText.querySelectorAll('tspan')) tspan.setAttribute('x', String(textX));
        return calloutText.getBBox();
      };

      callout.style.transformOrigin = `${cx}px ${cy}px`;
      callout.classList.add('is-open');
      let box = place(1);
      if (box.x + box.width > svgWidth - 8) box = place(-1);
      if (box.x < axisW + 4) box = place(1);

      calloutBg.setAttribute('x', String(box.x - 5));
      calloutBg.setAttribute('y', String(box.y - 2));
      calloutBg.setAttribute('width', String(Math.max(box.width, 1) + 10));
      calloutBg.setAttribute('height', String(Math.max(box.height, 1) + 4));
      showMonth(Number(dot.dataset.row));
    }

    function hide() {
      pinned = null;
      clearMark();
      showMonth(-1);
    }

    function focusDot(dot: SVGGElement) {
      for (const item of dots) item.tabIndex = item === dot ? 0 : -1;
      dot.focus();
      show(dot);
    }

    function move(dot: SVGGElement, key: string) {
      const col = Number(dot.dataset.col);
      const cy = Number(dot.dataset.cy);
      // The top of a column is the newest release, so sort by y rather than DOM order.
      const inCol = dots
        .filter((item) => Number(item.dataset.col) === col)
        .sort((a, b) => Number(a.dataset.cy) - Number(b.dataset.cy));
      if (key === 'Home') return focusDot(inCol[0]);
      if (key === 'End') return focusDot(inCol[inCol.length - 1]);
      if (key === 'ArrowUp' || key === 'ArrowDown') {
        const index = inCol.indexOf(dot);
        const next = inCol[index + (key === 'ArrowDown' ? 1 : -1)];
        if (next) focusDot(next);
        return;
      }
      const targetCol = col + (key === 'ArrowRight' ? 1 : -1);
      const candidates = dots.filter((item) => Number(item.dataset.col) === targetCol);
      if (!candidates.length) return;
      candidates.sort(
        (a, b) => Math.abs(Number(a.dataset.cy) - cy) - Math.abs(Number(b.dataset.cy) - cy),
      );
      focusDot(candidates[0]);
    }

    svg.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') return;
      root.classList.remove('is-instant');
      const row = rowFromEvent(event);
      showMonth(row);
      const onDot = (event.target as Element | null)?.closest?.('.release');
      if (pinned && !onDot) {
        pinned = null;
        clearMark();
      }
    });

    svg.addEventListener('pointerover', (event) => {
      if (event.pointerType === 'touch') return;
      const dot = (event.target as Element | null)?.closest?.('.release');
      if (!(dot instanceof SVGGElement) || dot === pinned) return;
      root.classList.remove('is-instant');
      pinned = dot;
      show(dot);
    });

    svg.addEventListener('pointerleave', () => {
      const active = document.activeElement;
      if (active instanceof SVGGElement && svg.contains(active) && active.classList.contains('release')) {
        pinned = active;
        root.classList.add('is-instant');
        show(active);
        return;
      }
      root.classList.remove('is-instant');
      hide();
    });

    svg.addEventListener('click', (event) => {
      const row = rowFromEvent(event);
      if (row >= 0) showMonth(row);
      const dot = (event.target as Element | null)?.closest?.('.release');
      if (dot instanceof SVGGElement) {
        pinned = dot;
        show(dot);
        return;
      }
      if (!(document.activeElement instanceof SVGGElement && svg.contains(document.activeElement))) {
        pinned = null;
        clearMark();
      }
    });

    svg.addEventListener('focusin', (event) => {
      const dot = (event.target as Element | null)?.closest?.('.release');
      if (!(dot instanceof SVGGElement)) return;
      root.classList.toggle('is-instant', dot.matches(':focus-visible'));
      pinned = dot;
      show(dot);
    });

    svg.addEventListener('focusout', (event) => {
      const next = event.relatedTarget;
      if (next instanceof Node && svg.contains(next)) return;
      hide();
    });

    svg.addEventListener('keydown', (event) => {
      const dot = (event.target as Element | null)?.closest?.('.release');
      if (!(dot instanceof SVGGElement)) return;
      if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(event.key)) {
        event.preventDefault();
        move(dot, event.key);
      }
    });
  }

  initModelsChart();
  document.addEventListener('astro:page-load', initModelsChart);
</script>
